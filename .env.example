PORT=3000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=matchlens-narrator
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SUBSCRIPTION_ID=
# Production authenticates with managed identity, local development with Azure CLI.
AI_MAX_REQUESTS_PER_HOUR=60
AI_MAX_CONCURRENT=2
# Storyline desk (Foundry agents) and archive retrieval (Foundry IQ over Azure AI Search).
PROJECT_ENDPOINT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=matchlens-archive
AZURE_SEARCH_KNOWLEDGE_BASE=matchlens-archive-kb
AZURE_SEARCH_KNOWLEDGE_SOURCE=matchlens-archive
# Optional Fabric Eventstream. Leave empty to use the in-process bus; never reuse the deployed app's stream.
EVENTSTREAM_SOURCE_CONNECTION_STRING=
EVENTSTREAM_DESTINATION_CONNECTION_STRING=
EVENTSTREAM_CONSUMER_GROUP=$Default
