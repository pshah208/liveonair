PORT=3000
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=matchlens-narrator
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_SUBSCRIPTION_ID=
# Production authenticates with managed identity, local development with Azure CLI.
AI_MAX_REQUESTS_PER_HOUR=120
AI_MAX_CONCURRENT=2
# Storyline desk (Foundry agents) and archive retrieval (Foundry IQ over Azure AI Search).
PROJECT_ENDPOINT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=matchlens-archive
AZURE_SEARCH_KNOWLEDGE_BASE=matchlens-archive-kb
AZURE_SEARCH_KNOWLEDGE_SOURCE=matchlens-archive
# Producer/studio bearer. Unset keeps local dev open. Fan View and GET endpoints stay public.
STUDIO_TOKEN=
# Minutes with no live match before a synthetic demo starts. 0 disables. Default 10 outside tests.
DEMO_WATCHDOG_MINUTES=10
# canonical keeps the current generator path. opta-format round-trips events through the synthetic Opta-style adapter.
LIVE_SOURCE=canonical
# Optional Fabric Eventstream. Leave empty to use the in-process bus; never reuse the deployed app's stream.
EVENTSTREAM_SOURCE_CONNECTION_STRING=
EVENTSTREAM_DESTINATION_CONNECTION_STRING=
EVENTSTREAM_CONSUMER_GROUP=$Default
# Optional agent endpoints: bearer token for /mcp (also unlocks drafts) and for A2A draft access.
MCP_TOKEN=
A2A_TOKEN=
# Optional OpenTelemetry export to Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=
